{
  "name": "careerai-backend",
  "version": "1.0.0",
  "description": "CareerAI - AI Career & Interview Intelligence Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node run_all_tests.js",
    "test:all": "node run_all_tests.js",
    "test:auth": "node test_auth.js",
    "test:resume": "node test_resume.js && node test_ai_analyzer.js",
    "test:jobs": "node test_jobs.js",
    "test:semantic": "node test_semantic.js && node test_matcher.js",
    "test:rag": "node test_rag.js",
    "test:interview": "node test_interview.js && node test_interview_flow.js && node test_voice_interview.js",
    "test:mentor": "node test_mentor.js",
    "test:roadmap": "node test_roadmap_analytics.js",
    "test:socket": "node test_socket_interview.js",
    "test:jobs-bg": "node test_background_jobs.js",
    "test:security": "node test_security_audit.js"
  },
  "keywords": [
    "careerai",
    "interview-prep",
    "mern",
    "express",
    "mongodb"
  ],
  "author": "CareerAI Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "nodemon": "^3.1.4",
    "pdf-lib": "^1.17.1"
  }
