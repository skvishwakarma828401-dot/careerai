# ==============================================================================
# CareerAI Platform Environment Configuration Template
# Copy this file to .env before starting the application.
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
# For Docker Compose: mongodb://mongodb:27017/careerai
# For Local Development: mongodb://127.0.0.1:27017/careerai
MONGODB_URI=mongodb://mongodb:27017/careerai

# Redis Configuration (In-Memory Caching & BullMQ Background Processing)
# For Docker Compose: redis://redis:6379 (Host: redis, Port: 6379)
# For Local Development: redis://127.0.0.1:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
USE_REDIS_MOCK=false

# Authentication & Security
# Generate a strong 64-character random string in production
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Google Gemini AI API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
